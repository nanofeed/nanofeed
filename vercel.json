{
  "version": 2,
  "framework": "nuxtjs",
  "cleanUrls": true,
  "installCommand": "npm ci",
  "buildCommand": "NITRO_PRESET=vercel npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "0 3 * * *"
    }
  ]
}
