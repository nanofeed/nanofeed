# Copy to .env for local development. See docs/DEPLOYMENT.md for every step.
# Neon: pooled URL for app traffic; direct URL for migrations. Keep TLS enabled.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Generate independent secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# RootCap is self-hosted: generate a separate random secret (at least 32 characters).
ROOTCAP_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth App: https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
# Production homepage: https://nanofeed.vercel.app
# Production callback: https://nanofeed.vercel.app/api/auth/callback/github
# In production set BOTH app URLs to https://nanofeed.vercel.app (no trailing slash).
# Use separate OAuth apps for development and production.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional GitHub fine-grained personal access token for higher contributor API rate limits.
# GitHub Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens.
# Public repository access and read-only repository metadata are sufficient; see docs/DEPLOYMENT.md.
GITHUB_CONTRIBUTORS_TOKEN=""

# Numeric GitHub ID, not a username. Optional; no owner is assigned when empty.
OWNER_GITHUB_ID=""

# Protects GET /api/cron/purge-deleted-accounts. Vercel sends it automatically.
CRON_SECRET=""
# Default build is portable Node. Vercel's build command sets NITRO_PRESET=vercel.
